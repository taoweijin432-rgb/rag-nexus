# PyMilvus 连接配置
MILVUS_URI=http://localhost:19530
# MILVUS_TOKEN 与 MILVUS_USER + MILVUS_PASSWORD 二选一。
MILVUS_TOKEN=
MILVUS_USER=
MILVUS_PASSWORD=
MILVUS_DB_NAME=
MILVUS_TIMEOUT=

# 集合配置
# Expert 存储 Profile。POC 验收和正式迁移完成前保持 v15；切换 V16 时必须同时把
# MILVUS_COLLECTION_NAME 改为 expert_candidates_v16_contract。
EXPERT_MILVUS_STORAGE_PROFILE=v15
# 12 字段原生 V16 保持 Chinese 兼容；原生 Jieba 大词典集合显式改为 jieba_targeted。
# V15/Resume 不加载下面的词典文件。不会自动修改或覆盖已存在的集合。
EXPERT_V16_ANALYZER=chinese
# 本地应用可读取的 UTF-8 一行一词文件；原生 V16 内嵌词条，外部 Jieba 在应用进程读取。
EXPERT_V16_DICTIONARY_PATH=
EXPERT_V16_DICTIONARY_VERSION=
# 文件字节的 SHA256（64 位小写十六进制），发布后必须固定，改词典需重新评估迁移。
EXPERT_V16_DICTIONARY_SHA256=
# 13 字段外部分词正式运行：Profile=v16_external_formal；HMM=True 的集合名为
# v16_external_jieba_accurate_v1。部署时同时配置词典路径、版本和 SHA256。
# 词典由部署环境单独提供，不随 Git/wheel 发布；路径填写应用可读取的外部绝对路径。
# 文件 SHA256 必须匹配现有集合。Python/Unicode/Jieba/过滤指纹必须与集合一致。
EXPERT_V16_EXTERNAL_HMM=false
# 写入当前 Expert Contract Collection；V14 25 字段物理形态已退役，
# 不再支持回滚 V14（factory schema_profile="v14" 会 fail-closed）。
# 历史 V14 Collection 仍受保护性检查保护，不被 drop/alter/migrate。
MILVUS_COLLECTION_NAME=expert_candidates_v15_contract
# 运行时仅支持正式 Contract 4.1.0。
MILVUS_SCHEMA_MODE=contract
# V15 使用下列 HNSW 配置；V16 Dense/Sparse 索引参数由冻结 Profile 固定。
MILVUS_INDEX_TYPE=HNSW

# 允许执行 destructive maintenance（stale 向量物理清理）的 Collection 名单，逗号分隔。
# 默认空 = 不允许任何 Collection 执行 destructive cleanup（fail-closed）。
# 只有 Full Sync 在删除 stale vectors 前需要显式授权，普通 CRUD 不受影响。
MILVUS_ALLOWED_DESTRUCTIVE_COLLECTIONS=
MILVUS_METRIC_TYPE=COSINE
MILVUS_INDEX_PARAMS='{"M":16,"efConstruction":200}'

# 阿里云百炼 Embedding 配置
# 当前供应商为阿里云百炼，请填写实际兼容 HTTP endpoint。
# 请求使用 Authorization: Bearer <EMBEDDING_API_KEY>。
EMBEDDING_API_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_MODEL_ALIAS=alibaba-bailian:text-embedding-v4
# 项目侧模型空间版本，不伪造阿里云供应商 revision。
EMBEDDING_MODEL_VERSION=v1
# 正式模型空间维度；客户端仍会校验 API 实际响应。
EMBEDDING_DIMENSION=1024
EMBEDDING_TIMEOUT=60
# Embedding 微批并发度（同一次 embed 内的厂商微批并发请求数）。
# 0/1 表示串行，>1 表示最多同时发起该数量的 HTTP 微批；默认 4。
EMBEDDING_CONCURRENCY=4

# 专家来源库：正式 Pipeline 只从该连接读取四张来源表。
SOURCE_DB_HOST=source-mysql.example.internal
SOURCE_DB_PORT=3306
SOURCE_DB_NAME=expert_source
SOURCE_DB_USER=expert_source_readonly
SOURCE_DB_PASSWORD=

# 本地索引状态库：必须显式配置，且不得与 SOURCE_DB_* 指向同一物理 Schema。
INDEX_DB_HOST=127.0.0.1
INDEX_DB_PORT=3306
INDEX_DB_NAME=expert_index_local
INDEX_DB_USER=expert_index_writer
INDEX_DB_PASSWORD=

# Resume 来源库：变量必须独立显式声明，不回退到 SOURCE_DB_*。
# 四张 resume_* 表可以与 Expert 四表位于同一个只读 Source Schema。
RESUME_SOURCE_DB_HOST=source-mysql.example.internal
RESUME_SOURCE_DB_PORT=3306
RESUME_SOURCE_DB_NAME=expert_source
RESUME_SOURCE_DB_USER=resume_source_readonly
RESUME_SOURCE_DB_PASSWORD=

# Resume 索引状态库：必须区别于 Resume Source、Expert SOURCE_DB_* 和 INDEX_DB_*。
RESUME_INDEX_DB_HOST=127.0.0.1
RESUME_INDEX_DB_PORT=3306
RESUME_INDEX_DB_NAME=resume_index_local
RESUME_INDEX_DB_USER=resume_index_writer
RESUME_INDEX_DB_PASSWORD=

# Resume Collection 必须显式配置，且不得等于上面的 Expert MILVUS_COLLECTION_NAME。
RESUME_MILVUS_COLLECTION_NAME=resume_candidates_v15_contract

# Resume Poll 独立开关与扫描参数；不读取下方 Expert INCREMENTAL_* 变量。
# 首次运行前先执行 init-checkpoints；默认建议 beginning。current 仅用于来源写入已暂停、
# 全量已完成且保持暂停到水位初始化结束的受控切换；此前保持关闭。
RESUME_INCREMENTAL_ENABLED=0
RESUME_INCREMENTAL_BATCH_SIZE=500
RESUME_INCREMENTAL_LEASE_SECONDS=120
# Poll 任务执行并发通过 Resume CLI 的 --worker-count 显式传入；默认 1，范围 1~4。
# 并发只发生在四张来源表之间，同一来源表内部仍保持严格 FIFO。

# Resume CDC 独立开关。完成真实 Probe、ACK/重投验证并部署常驻 Worker 前保持 0。
RESUME_CDC_ENABLED=0

# Resume 必须使用独立 destination 和 client_id，不得复用 Expert CDC 配置。
RESUME_CANAL_HOST=127.0.0.1
RESUME_CANAL_PORT=11111
RESUME_CANAL_DESTINATION=company_resume
# 启用 CDC 时必须显式填写 1~32767 的十进制 ID，并确保同一 destination 唯一。
RESUME_CANAL_CLIENT_ID=
RESUME_CANAL_SUBSCRIPTION='expert\.(resume|resume_work_experience|resume_project_experience|resume_education_experience)'
RESUME_CANAL_USERNAME=
RESUME_CANAL_PASSWORD=
RESUME_CANAL_SERVER_VERSION=1.1.8
RESUME_CANAL_SERVER_MODE=tcp
RESUME_CANAL_TCP_PORT=11111

# Resume CDC 协议门禁；只有真实连通、事件 Probe 和 ACK/重投验证通过后才更新。
RESUME_CDC_SOURCE_CONNECTED=0
RESUME_CDC_PROBE_BATCH_ID=0
RESUME_CDC_PROBE_ENTRY_COUNT=0
RESUME_CDC_ACK_CONFIRMED=0
RESUME_CDC_PROTOCOL_READY=0

# P3 候选扫描配置。默认关闭；开启后也只创建 pending 任务，不处理任务或推进 Checkpoint。
INCREMENTAL_ENABLED=0
# 一次 Source Keyset 查询最多读取的候选数，范围 1~1000。
INCREMENTAL_BATCH_SIZE=500
# 单张来源表扫描 lease 的有效秒数；长分页期间会按页续租。
INCREMENTAL_LEASE_SECONDS=120

# P7 真实 Canal 消费与 ACK 开关。固定回放和只读 Probe 不依赖该开关；未完成协议基线时保持 0。
CDC_ENABLED=0

# 真实 Canal Client 配置；密码只放部署环境，不提交到仓库。
CANAL_HOST=127.0.0.1
CANAL_PORT=11111
CANAL_DESTINATION=company_expert
# 同一 destination 只运行一个 CDC Worker，重连时必须保持相同 ID（范围 1~32767）。
CANAL_CLIENT_ID=2001
CANAL_SUBSCRIPTION=expert\.(experts|experts_work_experience|experts_project_experience|experts_education_experience)
CANAL_USERNAME=
CANAL_PASSWORD=
CANAL_SERVER_VERSION=1.1.8
CANAL_SERVER_MODE=tcp
CANAL_TCP_PORT=11111

# 以下四项是协议基线门禁。只有真实 Probe、源连接和 ACK/重投测试完成后才全部设为 1/实际值。
CDC_SOURCE_CONNECTED=0
CDC_PROBE_BATCH_ID=0
CDC_PROBE_ENTRY_COUNT=0
CDC_ACK_CONFIRMED=0
CDC_PROTOCOL_READY=0

# canal-python 0.4 使用旧版生成的 Protobuf。CLI 会自动设置该变量；手工启动服务时也应保留。
# export PROTOCOL_BUFFERS_PYTHON_IMPLEMENTATION=python

# 本地 MySQL 只读 Schema 验证配置
# 本轮脚本只执行 SELECT / SHOW，不修改数据库。
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=

# 仅显式设置为 1 时运行真实 MySQL + Alibaba Bailian E2E 测试。
RUN_REAL_E2E=0
