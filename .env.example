# PyMilvus 连接配置
MILVUS_URI=http://localhost:19530
# MILVUS_TOKEN 与 MILVUS_USER + MILVUS_PASSWORD 二选一。
MILVUS_TOKEN=
MILVUS_USER=
MILVUS_PASSWORD=
MILVUS_DB_NAME=
MILVUS_TIMEOUT=

# 集合配置
MILVUS_COLLECTION_NAME=expert_candidates_v12_contract_dev
# 当前代码只写入正式 Contract Collection；历史 Collection 仅作保护对象。
# DEV Contract Collection 使用 HNSW + COSINE。
MILVUS_INDEX_TYPE=AUTOINDEX
MILVUS_METRIC_TYPE=COSINE
MILVUS_INDEX_PARAMS='{}'

# 公司云端 Embedding 配置
# 请求使用 Authorization: Bearer <EMBEDDING_API_KEY>。
# API 地址填写公司实际的 Embedding endpoint，不要填写示例地址。
EMBEDDING_API_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_MODEL_ALIAS=text-embedding-v4
# 如果公司 API 没有提供 revision/version，可以留空。
EMBEDDING_MODEL_VERSION=
# 已经通过真实 smoke test 确认的维度；客户端仍会校验 API 实际响应。
EMBEDDING_DIMENSION=1024
EMBEDDING_TIMEOUT=60

# 本地 MySQL 只读 Schema 验证配置
# 本轮脚本只执行 SELECT / SHOW，不修改数据库。
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
